# ============================================================
#  "Crimson Gale"  -  16-bar loop BGM for MewMMLPad
#  Key: A minor (harmonic-minor V) / 4-4 / T132
# ------------------------------------------------------------
#  Chord loop (1 bar each, loops seamlessly at bar 16 -> bar 1)
#    1 Am   2 F    3 C    4 G
#    5 Am   6 F    7 Dm   8 E
#    9 Am  10 G   11 F   12 E     <- descending "Andalusian" hook
#   13 Dm  14 C   15 F   16 E     <- turnaround back to Am
# ------------------------------------------------------------
#  Tracks (A-P = MIDI ch 1-16)
#    A  ch1  Lead melody          @81 saw lead
#    B  ch2  Counter melody       @80 square lead
#    C  ch3  Pad (moving 2nds)    @89 warm pad
#    D  ch4  16th arpeggio        @27 clean guitar
#    E  ch5  Bass                 @39 synth bass 2
#    F  ch6  Brass stabs          @62 brass section
#    J  ch10 Drums: kick/snare/tom      (GM drum channel)
#    K  ch11 Drums: hi-hat/cymbal       (assign a drum kit here too)
#
#  NOTE: an MML track is monophonic, so the kit is split across two
#  tracks. Crashes/rides live on K (with the hats) so they never
#  collide with the kick/snare on J.
# ============================================================

A T120

ABCDEF  {=*} $BendRange=2 $Glissando=16

A @81 L8  Q8 V104 PC       ; lead
B @80 L8  Q7 V76  PR36     ; counter
C @89 L2  Q8 V58  PL30     ; pad
D @27 L16 Q6 V68  PR44     ; arpeggio
E @39 L8  Q6 V102 PC       ; bass
F @62 L8  Q5 V84  PL44     ; brass stabs
J @0  L16 Q8 V108 PC LV28  ; drums 1 (ch10)
K @0  L16 Q8 V92  PC       ; drums 2 (ch11)


; ------------------------------------------------------------
; drum patterns  (L16, 16 slots = 1 bar)
; ------------------------------------------------------------
% DkA    N36 R8. N38 R8 N36 R8 N36 R16 N38 R16 N36 R16
% DkB    N36 R8. N38 R8 N36 R8 N36 R16 N38 ( N38 ) N36 R16
% DkC    N36 R16 N36 R16 N38 R8 N36 R8 N36 R16 N38 R16 N36 R16
% DkD    N36 R8. N38 R8 N36 R8 N38 R16 N38 R16 N36 R16
% DkFilA N36 R8. N38 R8 N36 R8 N38 R16 N38 N38 N36 N36
% DkFilB N36 R8. N38 R8 N36 R16 N50 N48 N47 N45 N43 N41 N38

; Eighth-note hats carry the whole piece; bars 9-12 switch to the ride.
% Hh8  V94 N42 R16 V64 N42 R16
% Hh8o V94 N42 R16 V84 N46 R16
% Rd8  V92 N51 R16 V64 N51 R16

; Sixteenth-note hats, four velocity levels. Not used at the moment -- swap
; %Hh8 -> %HhQ and %Hh8o -> %HhE on the K lines to double the hat density.
% HhQ V92 N42 V56 N42 V72 N42 V58 N42
% HhE V92 N42 V56 N42 V72 N42 V84 N46
% HhO V92 N42 V56 N42 V84 N46 R16


; ============================================================
;  bars 1-4    Am  F  C  G
; ============================================================
A o5 V104 e8 f8 g8 a8 b4 >c4&c4 d8. c4 <a4 g16&g8 a8 b8. >c4 <b8. g8   f4 g8 a4 b4 >d8
B o4 V74  a2 >c4 <b8 a8             f2 a4 >c8 <a8
B o4      e2 g4 a8 g8               d4. g8 b8 >d8 <b8 a8
C o4 V54  e2 a2                     f2 a2
C o4      e2 g2                     d2 g2
